# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here

# Webhook Configuration (required for production / FastAPI mode)
# - Production: set to your Railway URL, e.g. https://your-app.up.railway.app
# - Local dev: leave empty to fall back to polling mode
WEBHOOK_URL=
# Optional shared secret Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token header
WEBHOOK_SECRET=

# Comma-separated Telegram user IDs granted ADMIN role on first run
ADMIN_USER_IDS=

# LOCAL DEV ONLY: bypass Telegram WebApp init-data verification so the
# Mini App can be opened in a regular browser. Active ONLY when
# WEBHOOK_URL is empty. The "logged-in" user becomes the first ID in
# ADMIN_USER_IDS. NEVER enable this on Railway / in production.
DEV_BYPASS_AUTH=false

# Google Sheets (required from Phase 1 onward)
# Sheet URL example: https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit
# Take the SHEET_ID portion of the URL (between /d/ and /edit)
GOOGLE_SHEET_ID=1i-opCpouBY-PPDVUzQciU_1CJZwfPadBx3u1M67lHd4
# Paste full service-account JSON on one line (or use Railway's file/env panel)
GOOGLE_CREDENTIALS_JSON=

# Optional: Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=bot.log
